# Release packaging script — cmake -P release.cmake
set(SRC_DIR "@CMAKE_SOURCE_DIR@")
set(BIN_DIR "@CMAKE_BINARY_DIR@")
set(REL_DIR "${BIN_DIR}/release")
set(CFG "@CMAKE_BUILD_TYPE@")
if(NOT CFG)
    set(CFG "Release")
endif()

file(REMOVE_RECURSE "${REL_DIR}")
file(MAKE_DIRECTORY "${REL_DIR}/include" "${REL_DIR}/lib" "${REL_DIR}/bin")

# ── Headers ──
file(COPY "${SRC_DIR}/whisper-xpu-core/whisper_xpu_core.h" DESTINATION "${REL_DIR}/include")
file(COPY "${SRC_DIR}/whisper-xpu-core/export.h"           DESTINATION "${REL_DIR}/include")

# ── Import libraries (for downstream consumers) ──
file(COPY "${BIN_DIR}/whisper-xpu-core/${CFG}/whisper_xpu_sycl_core.lib"
     DESTINATION "${REL_DIR}/lib")

# ── DLLs ──
file(COPY "${BIN_DIR}/whisper-xpu-core/${CFG}/whisper_xpu_sycl_core.dll"
     DESTINATION "${REL_DIR}/bin")

# ── App ──
file(COPY "${BIN_DIR}/whisper-xpu-app/${CFG}/whisper_xpu_app.exe"
     DESTINATION "${REL_DIR}/bin")

# ── Intel oneAPI compiler runtime DLLs ──
get_filename_component(_rt_root "@SYCL_LIBRARY_DIR@/.." ABSOLUTE)
file(GLOB _rt_dlls
    "${_rt_root}/bin/sycl*.dll"
    "${_rt_root}/bin/svml_dispmd.dll"
    "${_rt_root}/bin/libmmd.dll"
    "${_rt_root}/bin/libiomp5md.dll"
    "${_rt_root}/bin/ur_win_proxy_loader.dll"
    "${_rt_root}/bin/ur_loader.dll"
    "${_rt_root}/bin/ur_adapter_level_zero*.dll"
    "${_rt_root}/bin/ur_adapter_opencl.dll"
    "${_rt_root}/bin/umf.dll"
    "${_rt_root}/bin/tcm.dll")
foreach(_d ${_rt_dlls})
    if(EXISTS "${_d}")
        file(COPY "${_d}" DESTINATION "${REL_DIR}/bin")
    endif()
endforeach()


# ── oneDNN DLL (ONEDNN_STATIC=OFF only) ──
if("@ONEDNN_STATIC@" STREQUAL "OFF" AND "@DNNL_FOUND@" STREQUAL "TRUE")
    get_target_property(_d DNNL::dnnl IMPORTED_LOCATION_RELEASE)
    if(_d AND EXISTS "${_d}")
        file(COPY "${_d}" DESTINATION "${REL_DIR}/bin")
    endif()
endif()

# ── Summary ──
file(GLOB_RECURSE FILES "${REL_DIR}/*")
message(STATUS "Release: ${REL_DIR}")
foreach(F ${FILES})
    file(RELATIVE_PATH R "${REL_DIR}" "${F}")
    file(SIZE "${F}" SZ)
    math(EXPR SZ "${SZ} / 1024")
    message(STATUS "  ${R} (${SZ} KB)")
endforeach()
