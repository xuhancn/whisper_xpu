# Release packaging script
# Called from: cmake -P release.cmake
# @CMAKE_BINARY_DIR@, @CMAKE_SOURCE_DIR@ etc. are substituted by configure_file()

set(SRC_DIR "@CMAKE_SOURCE_DIR@")
set(BIN_DIR "@CMAKE_BINARY_DIR@")
set(REL_DIR "${BIN_DIR}/release")
set(CFG "@CMAKE_BUILD_TYPE@")
if(NOT CFG)
    set(CFG "Release")
endif()

file(REMOVE_RECURSE "${REL_DIR}")
file(MAKE_DIRECTORY "${REL_DIR}/include" "${REL_DIR}/lib" "${REL_DIR}/bin")

# Copy public headers
file(COPY "${SRC_DIR}/whisper-xpu-core/whisper_xpu_core.h" DESTINATION "${REL_DIR}/include")
file(COPY "${SRC_DIR}/whisper-xpu-core/export.h"           DESTINATION "${REL_DIR}/include")

# Copy merged library
set(LIB_FILE "${BIN_DIR}/whisper-xpu-core/${CFG}/whisper_xpu_core.lib")
if(EXISTS "${LIB_FILE}")
    file(COPY "${LIB_FILE}" DESTINATION "${REL_DIR}/lib")
else()
    message(FATAL_ERROR "whisper_xpu_core.lib not found at ${LIB_FILE}")
endif()

# Copy SYCL runtime DLL if present
if("@HAVE_SYCL@" STREQUAL "TRUE")
    set(SYCL_DLL "@SYCL_LIBRARY_DIR@/sycl.dll")
    if(EXISTS "${SYCL_DLL}")
        file(COPY "${SYCL_DLL}" DESTINATION "${REL_DIR}/bin")
    else()
        message(WARNING "sycl.dll not found at ${SYCL_DLL}")
    endif()
endif()

# Copy dnnl.dll if dynamic linking (ONEDNN_STATIC=OFF)
if("@DNNL_FOUND@" STREQUAL "TRUE")
    if("@ONEDNN_STATIC@" STREQUAL "OFF")
        get_target_property(DLL_LOC DNNL::dnnl IMPORTED_LOCATION_RELEASE)
        if(DLL_LOC AND EXISTS "${DLL_LOC}")
            file(COPY "${DLL_LOC}" DESTINATION "${REL_DIR}/bin")
        endif()
    endif()
endif()

# Summary
file(GLOB_RECURSE REL_FILES "${REL_DIR}/*")
list(LENGTH REL_FILES N)
message(STATUS "Release package created: ${REL_DIR}")
foreach(F ${REL_FILES})
    file(RELATIVE_PATH RF "${REL_DIR}" "${F}")
    message(STATUS "  ${RF}")
endforeach()
