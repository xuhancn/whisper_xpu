# Release packaging script — cmake -P release.cmake
set(SRC_DIR "@CMAKE_SOURCE_DIR@")
set(BIN_DIR "@CMAKE_BINARY_DIR@")
set(REL_DIR "${BIN_DIR}/release")
set(CFG "@CMAKE_BUILD_TYPE@")
if(NOT CFG)
    set(CFG "Release")
endif()

file(REMOVE_RECURSE "${REL_DIR}")
file(MAKE_DIRECTORY "${REL_DIR}/include" "${REL_DIR}/lib" "${REL_DIR}/bin")

# ── Headers ──
file(COPY "${SRC_DIR}/whisper-xpu-core/whisper_xpu_core.h" DESTINATION "${REL_DIR}/include")
file(COPY "${SRC_DIR}/whisper-xpu-core/export.h"           DESTINATION "${REL_DIR}/include")

# ── Library ──
set(LIB "${BIN_DIR}/whisper-xpu-core/${CFG}/whisper_xpu_core.lib")
if(EXISTS "${LIB}")
    file(COPY "${LIB}" DESTINATION "${REL_DIR}/lib")
else()
    message(FATAL_ERROR "whisper_xpu_core.lib not found")
endif()

# ── App ──
set(APP "${BIN_DIR}/whisper-xpu-app/${CFG}/whisper_xpu_app.exe")
if(EXISTS "${APP}")
    file(COPY "${APP}" DESTINATION "${REL_DIR}/bin")
endif()

# ── SYCL runtime DLL (sycl8.dll or sycl*.dll in compiler bin dir) ──
get_filename_component(_sycl_root "@SYCL_LIBRARY_DIR@/.." ABSOLUTE)
file(GLOB _sycl_dlls "${_sycl_root}/bin/sycl*.dll")
foreach(_dll ${_sycl_dlls})
    file(COPY "${_dll}" DESTINATION "${REL_DIR}/bin")
endforeach()
if(NOT _sycl_dlls)
    message(STATUS "SYCL runtime DLL not found (expected in ${_sycl_root}/bin/)")
endif()

# ── oneDNN DLL (only when ONEDNN_STATIC=OFF) ──
if("@ONEDNN_STATIC@" STREQUAL "OFF" AND "@DNNL_FOUND@" STREQUAL "TRUE")
    get_target_property(_dll DNNL::dnnl IMPORTED_LOCATION_RELEASE)
    if(_dll AND EXISTS "${_dll}")
        file(COPY "${_dll}" DESTINATION "${REL_DIR}/bin")
    endif()
endif()

# ── Summary ──
file(GLOB_RECURSE FILES "${REL_DIR}/*")
message(STATUS "Release: ${REL_DIR}")
foreach(F ${FILES})
    file(RELATIVE_PATH R "${REL_DIR}" "${F}")
    file(SIZE "${F}" SZ)
    math(EXPR SZ "${SZ} / 1024")
    message(STATUS "  ${R} (${SZ} KB)")
endforeach()
