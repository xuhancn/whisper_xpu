# Build directories (CMake)
build-*/
build/

# Models — large binaries, not source. The two SMALL bundled models
# (tiny + VAD) ship in the repo so a fresh clone can run release_package;
# everything else (medium/large q5_0, etc.) is gitignored — users download
# those themselves.
models/*
!models/ggml-tiny.bin
!models/vad_model/
!models/vad_model/ggml-vad.bin

# Runtime logs
*.log

# Release packages
release/

# Local task planning scratch (ephemeral)
TASKS_PLAN.md
