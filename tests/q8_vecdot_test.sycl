// Standalone SYCL test for q8_0 reorder vec_dot (the actual mul_mat_vec_q_reorder path).
// Tests: reorder_qw_q8_0 + quantize_and_reorder_q8_1_soa + mul_mat_vec_q_reorder
// Compares GPU result with CPU golden dot product.
// Compile: icpx -fsycl -I"<MSVC include>" -o q8_vecdot_test q8_vecdot_test.sycl

#include <sycl/sycl.hpp>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <vector>

using half = sycl::half;
using half2 = sycl::half2;

constexpr int QK8_0 = 32;
constexpr int QK8_1 = 32;
constexpr int WARP_SIZE = 16;
constexpr int QI8_0 = 8;
constexpr int VDR_Q8_0_Q8_1_MMVQ = 2;  // from ggml-sycl vecdotq.hpp
constexpr int GGML_SYCL_DMMV_X = 32;
constexpr int GGML_SYCL_MMV_Y = 1;

struct block_q8_0 {
    half d;
    int8_t qs[QK8_0];
};

struct block_q8_1 {
    half d;
    half s;
    int8_t qs[QK8_1];
};

// ── get_int_from_int8 (from vecdotq.hpp) ──
static int get_int_from_int8(const int8_t* x8, int i32) {
    const uint16_t* x16 = (const uint16_t*)(x8 + sizeof(int) * i32);
    int x32 = 0;
    x32 |= x16[0] << 0;
    x32 |= x16[1] << 16;
    return x32;
}

static int get_int_from_int8_aligned(const int8_t* x8, int i32) {
    return get_int_from_int8(x8, i32);  // same for our test
}

// ── dp4a (from dpct helper) ──
static int dp4a(int a, int b, int c) {
    int8_t* va = (int8_t*)&a;
    int8_t* vb = (int8_t*)&b;
    return c + va[0]*vb[0] + va[1]*vb[1] + va[2]*vb[2] + va[3]*vb[3];
}

// ── reorder_qw_q8_0 (weight reorder) ──
void reorder_qw_q8_0_gpu(sycl::queue& q, uint8_t* data, int ncols, int nrows, size_t size) {
    uint8_t* tmp = sycl::malloc_device<uint8_t>(size, q);
    q.memcpy(tmp, data, size).wait();
    auto qs_ptr = data;
    auto d_ptr = (half*)(qs_ptr + ncols * nrows);
    q.parallel_for(sycl::range<1>(size / sizeof(block_q8_0)),
        [=](sycl::id<1> i) {
            const block_q8_0* x = (const block_q8_0*)tmp;
            const int ib = i[0];
            for (int j = 0; j < QK8_0; j++)
                *((int8_t*)qs_ptr + ib * QK8_0 + j) = x[ib].qs[j];
            *(d_ptr + ib) = x[ib].d;
        }).wait();
    sycl::free(tmp, q);
}

// ── quantize_and_reorder_q8_1_soa (activation quantize to SoA) ──
// Simplified: 1 element per work item (ElementsPerWI=1)
void quantize_q8_1_soa_gpu(sycl::queue& q, const float* x, void* out, int kx, int kx_padded) {
    int num_blocks = kx / QK8_1;
    q.parallel_for(sycl::range<1>(num_blocks),
        [=](sycl::id<1> i) {
            int subgroup_id = i[0];
            int row = 0;  // single row
            int col = subgroup_id;
            int row_offset = row * (kx_padded / QK8_1) * sizeof(block_q8_1);

            // Quantize block: d = max(|x|), qs = round(x / d * 127)
            float amax = 0.0f;
            for (int j = 0; j < QK8_1; j++) {
                float v = x[col * QK8_1 + j];
                amax = fmax(amax, fabsf(v));
            }
            float d = amax / 127.0f;
            float id = d != 0.0f ? 1.0f / d : 0.0f;
            float sum = 0.0f;
            int8_t qs[QK8_1];
            for (int j = 0; j < QK8_1; j++) {
                float v = x[col * QK8_1 + j];
                qs[j] = (int8_t)roundf(v * id);
                sum += qs[j];
            }

            // Write SoA: qs at [row_offset + QK8_1*col + j], ds at [row_offset + kx + col*4]
            int8_t* quant_ptr = (int8_t*)((char*)out + row_offset + QK8_1 * col);
            for (int j = 0; j < QK8_1; j++)
                quant_ptr[j] = qs[j];

            half2* ds_ptr = (half2*)((char*)out + row_offset + kx + col * sizeof(half2));
            *ds_ptr = half2(half(d), half(sum));
        }).wait();
}

// ── mul_mat_vec_q_reorder (the actual kernel) ──
// Simplified: single row, single sub-group
void mul_mat_vec_q_reorder_gpu(sycl::queue& q, const void* vx, const void* vy,
                                float* dst, int ncols, int nrows) {
    constexpr int vdr_mmvq = VDR_Q8_0_Q8_1_MMVQ;  // 2
    constexpr int qi = QI8_0;  // 8
    constexpr int blocks_per_subgroup = (vdr_mmvq * WARP_SIZE + qi - 1) / qi;  // (2*16+8-1)/8 = 5
    constexpr int block_elements_per_subgroup = qi / vdr_mmvq;  // 8/2 = 4
    int blocks_per_row = ncols / QK8_0;  // 1280/32 = 40

    q.parallel_for(sycl::nd_range<1>(sycl::range<1>(WARP_SIZE), sycl::range<1>(WARP_SIZE)),
        [=](sycl::nd_item<1> item) {
            int row = 0;
            if (row >= nrows) return;

            float partial_sum = 0.0f;
            for (int i = item.get_local_id(0) / block_elements_per_subgroup;
                 i < blocks_per_row; i += blocks_per_subgroup) {
                int ibx = row * blocks_per_row + i;

                // bx_offset = ibx * QK8_0
                int bx_offset = ibx * QK8_0;
                // d_offset = ncols * nrows + ibx * sizeof(half)
                int d_offset = ncols * nrows + ibx * sizeof(half);

                // Y
                int iby = i;  // block_to_q8_1_ratio = 1
                const int8_t* q8_1_quant_ptr = (const int8_t*)vy + iby * QK8_1;
                const half2* q8_1_ds_ptr = (const half2*)((const char*)vy + ncols + iby * sizeof(half2));

                for (int elem = 0; elem < block_elements_per_subgroup; elem += WARP_SIZE) {
                    int iqs = elem + vdr_mmvq * (item.get_local_id(0) % block_elements_per_subgroup);

                    // vec_dot_q8_0_q8_1 reorder
                    const uint8_t* base = (const uint8_t*)vx;
                    const int8_t* qs = (const int8_t*)(base + bx_offset);
                    const half d = *(const half*)(base + d_offset);

                    int v[vdr_mmvq];
                    int u[vdr_mmvq];
                    for (int ii = 0; ii < vdr_mmvq; ii++) {
                        v[ii] = get_int_from_int8(qs, iqs + ii);
                        u[ii] = get_int_from_int8_aligned(q8_1_quant_ptr, iqs + ii);
                    }

                    int sumi = 0;
                    for (int ii = 0; ii < vdr_mmvq; ii++)
                        sumi = dp4a(v[ii], u[ii], sumi);

                    const half2 ds_values = *q8_1_ds_ptr;
                    partial_sum += (float)d * (float)ds_values[0] * (float)sumi;
                }
            }

            // Reduce across sub-group
            auto sum = sycl::reduce_over_group(item.get_sub_group(), partial_sum, std::plus<>());
            if (item.get_sub_group().get_local_linear_id() == 0)
                dst[row] = sum;
        }).wait();
}

int main() {
    const int ncols = 1280;
    const int nrows = 1;
    const int n_blocks = ncols * nrows / QK8_0;  // 40
    const size_t weight_size = n_blocks * sizeof(block_q8_0);  // 40*34=1360

    sycl::queue q(sycl::gpu_selector_v);
    printf("Device: %s\n", q.get_device().get_info<sycl::info::device::name>().c_str());

    // ── Create weight (block_q8_0) ──
    std::vector<block_q8_0> weight(n_blocks);
    for (int b = 0; b < n_blocks; b++) {
        weight[b].d = half(1.0f + b * 0.01f);
        for (int i = 0; i < QK8_0; i++)
            weight[b].qs[i] = (int8_t)(i - 16);
    }

    // ── Create activation (float) ──
    std::vector<float> activation(ncols);
    for (int i = 0; i < ncols; i++)
        activation[i] = (float)(i % 10) * 0.1f;

    // ── CPU golden dot product ──
    // For each block: dot = sum(d_weight * qs_weight[i] * activation[i])
    // Then d_activation = max(|activation|), qs_activation = round(x/d_act*127)
    // dot = d_weight * d_activation * sum(qs_weight[i] * qs_activation[i])
    float golden = 0.0f;
    for (int b = 0; b < n_blocks; b++) {
        // Quantize activation block
        float amax = 0.0f;
        for (int j = 0; j < QK8_1; j++) {
            float v = activation[b * QK8_1 + j];
            amax = fmax(amax, fabsf(v));
        }
        float d_act = amax / 127.0f;
        float id_act = d_act != 0.0f ? 1.0f / d_act : 0.0f;
        int8_t qs_act[QK8_1];
        for (int j = 0; j < QK8_1; j++)
            qs_act[j] = (int8_t)roundf(activation[b * QK8_1 + j] * id_act);

        float d_w = float(weight[b].d);
        int sumi = 0;
        for (int j = 0; j < QK8_0; j++)
            sumi += weight[b].qs[j] * qs_act[j];
        golden += d_w * d_act * (float)sumi;
    }
    printf("CPU golden dot: %.4f\n", golden);

    // ── GPU: reorder weight ──
    uint8_t* gpu_weight = sycl::malloc_device<uint8_t>(weight_size, q);
    q.memcpy(gpu_weight, weight.data(), weight_size).wait();
    reorder_qw_q8_0_gpu(q, gpu_weight, ncols, nrows, weight_size);

    // ── GPU: quantize activation to SoA ──
    int kx = ncols;
    int kx_padded = ncols;
    int act_soa_size = (kx_padded / QK8_1) * sizeof(block_q8_1);  // 40*36=1440
    void* gpu_act = sycl::malloc_device<uint8_t>(act_soa_size, q);
    float* gpu_act_f32 = sycl::malloc_device<float>(ncols, q);
    q.memcpy(gpu_act_f32, activation.data(), ncols * sizeof(float)).wait();
    quantize_q8_1_soa_gpu(q, gpu_act_f32, gpu_act, kx, kx_padded);

    // ── GPU: mul_mat_vec_q_reorder ──
    float* gpu_dst = sycl::malloc_device<float>(1, q);
    q.memset(gpu_dst, 0, sizeof(float)).wait();
    mul_mat_vec_q_reorder_gpu(q, gpu_weight, gpu_act, gpu_dst, ncols, nrows);

    // ── Copy back ──
    float gpu_result;
    q.memcpy(&gpu_result, gpu_dst, sizeof(float)).wait();
    printf("GPU dot: %.4f\n", gpu_result);
    printf("Match: %s\n", fabsf(gpu_result - golden) < 1.0f ? "YES" : "NO");
    if (fabsf(gpu_result - golden) >= 1.0f)
        printf("Diff: %.4f\n", gpu_result - golden);

    // ── Dump intermediate data for debugging ──
    // Copy back reordered weight
    std::vector<uint8_t> reordered(weight_size);
    q.memcpy(reordered.data(), gpu_weight, weight_size).wait();
    // Copy back SoA activation
    std::vector<uint8_t> act_soa(act_soa_size);
    q.memcpy(act_soa.data(), gpu_act, act_soa_size).wait();

    // Verify weight reorder
    bool w_ok = true;
    for (int b = 0; b < n_blocks; b++) {
        int8_t* qs = (int8_t*)reordered.data() + b * QK8_0;
        for (int j = 0; j < QK8_0; j++)
            if (qs[j] != weight[b].qs[j]) { w_ok = false; break; }
        half* d = (half*)(reordered.data() + ncols * nrows + b * sizeof(half));
        if (float(*d) != float(weight[b].d)) { w_ok = false; }
    }
    printf("Weight reorder: %s\n", w_ok ? "OK" : "FAIL");

    // Verify activation SoA
    bool a_ok = true;
    for (int b = 0; b < n_blocks; b++) {
        int8_t* qs = (int8_t*)act_soa.data() + b * QK8_1;
        half2* ds = (half2*)(act_soa.data() + ncols + b * sizeof(half2));
        // Recompute
        float amax = 0.0f;
        for (int j = 0; j < QK8_1; j++)
            amax = fmax(amax, fabsf(activation[b * QK8_1 + j]));
        float d_exp = amax / 127.0f;
        if (fabsf(float((*ds)[0]) - d_exp) > 0.01f) { a_ok = false; break; }
    }
    printf("Activation SoA: %s\n", a_ok ? "OK" : "FAIL");

    sycl::free(gpu_weight, q);
    sycl::free(gpu_act, q);
    sycl::free(gpu_act_f32, q);
    sycl::free(gpu_dst, q);

    printf("\n=== Done ===\n");
    return 0;
}
